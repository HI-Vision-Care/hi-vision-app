{
  "expo": {
    "name": "Hi-Vision",
    "slug": "hi-vision",
    "version": "1.0.3",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "scheme": "hivisionmobileapp",
    "android": {
      "package": "com.anonymous.HI_Vision_Mobile_App",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [{ "scheme": "hivisionmobileapp" }]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.HI-Vision-Mobile-App"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "63718a04-7fcb-4a1a-87f9-aecbf774b5e5" }
    },
    "owner": "dkhoa_happy"
  }
}
